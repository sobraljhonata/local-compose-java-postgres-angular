# syntax=docker/dockerfile:1
# Context de build: diretório pai (serpro/), dockerfile neste path.
# Homologação: bundle usa environment do clone (localhost:*), nginx na 4200.

FROM node:22-bookworm AS build
WORKDIR /app
ENV HUSKY=0 NG_CLI_ANALYTICS=false

COPY autua-web-frontend/package.json autua-web-frontend/package-lock.json ./
RUN npm ci --ignore-scripts || npm ci --ignore-scripts --legacy-peer-deps

COPY autua-web-frontend/angular.json autua-web-frontend/tsconfig.json autua-web-frontend/tsconfig.app.json ./
COPY autua-web-frontend/src ./src
COPY autua-web-frontend/public ./public

RUN npx ng build --configuration=local --no-progress

FROM nginx:1.27-alpine AS runtime
COPY autua-local-compose/docker/web/nginx.homolog.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist/ /tmp/dist/
RUN set -e; \
    if [ -d /tmp/dist/browser ]; then cp -a /tmp/dist/browser/. /usr/share/nginx/html/; \
    else DIR=$(find /tmp/dist -type d -name browser | head -n1); \
         test -n "$DIR"; cp -a "$DIR"/. /usr/share/nginx/html/; fi
EXPOSE 4200
CMD ["nginx", "-g", "daemon off;"]
