# Copiar para .env (NÃO versionar .env)
# Senhas e segredos apenas locais.

COMPOSE_PROJECT_NAME=autua-local
AUTUA_IMAGE_TAG=dev
AUTUA_MODE=dev

# Portas host (127.0.0.1).
# Defaults clássicos 8080/8081/4200/5433 conflitam com stacks GD host — remap recomendado:
POSTGRES_HOST_PORT=5434
API_HOST_PORT=18080
BFF_HOST_PORT=18081
WEB_HOST_PORT=14200
AUTH_MOCK_HOST_PORT=18082

POSTGRES_DB=autua_local
POSTGRES_USER=autua
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_IMAGE_TAG=17-alpine

# Role de aplicação (NOSUPERUSER) — criada no restore/grants
DATASOURCE_USER_NAME=autua_app
DATASOURCE_PASSWORD=CHANGE_ME_APP_LOCAL_ONLY

# Dump sanitizado: caminho ABSOLUTO local (NÃO commit). Ver docs/restore.md
AUTUA_PG_BACKUP_PATH=

SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_VALIDATE_ON_MIGRATE=false
SPRING_FLYWAY_LOCATIONS=classpath:db/migration

# WEB host (web-start.ps1) + tip :4200
CORS_URLS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:14200,http://127.0.0.1:14200
AUTUA_BFF_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:14200,http://127.0.0.1:14200
AUTUA_BFF_CORS_ENABLED=true
AUTUA_BFF_CORS_ALLOW_CREDENTIALS=false

# QR / urlConsumo absoluto (APP físico via adb reverse :8081→18081)
AUTUA_BFF_PUBLIC_BASE_URL=http://127.0.0.1:18081/autua-bff

# --- Auth mock (--profile auth-mock) ---
GELUS_ISSUER_URI=http://auth-mock:8080/realms/autua-local
JWT_ISSUER_URI=http://auth-mock:8080/realms/autua-local
JWT_JWK_SET_URI=http://auth-mock:8080/realms/autua-local/protocol/openid-connect/certs
AUTUA_BFF_AUTH_LOGIN_BASE_URL=http://auth-mock:8080/auth/login
AUTUA_BFF_AUTENTICACAO_API_BASE_URL=http://auth-mock:8080
GELUS_CLIENT_ID=autua-local
GELUS_CLIENT_SECRET=autua-local-secret
GELUS_AUDIENCE=10197_radar
LOCAL_ISSUER=http://auth-mock:8080/realms/autua-local
LOCAL_PUBLIC_BASE=http://127.0.0.1:18082
LOCAL_CLIENT_ID=autua-local
LOCAL_CLIENT_SECRET=autua-local-secret
LOCAL_ORGAO_CNPJ=00000000000191
LOCAL_ORGAO_ID=919001
LOCAL_UNIDADE_ID=91910
LOCAL_AZP=10197_radar

AUTUA_ALLOW_DIRTY=0
