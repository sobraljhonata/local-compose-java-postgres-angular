# Copiar para .env (NÃO versionar .env)
# Senhas e segredos apenas locais.

COMPOSE_PROJECT_NAME=autua-local
AUTUA_IMAGE_TAG=dev
AUTUA_MODE=dev
# homolog: exige git limpo OU AUTUA_ALLOW_DIRTY=1 + manifesto

# Portas host (127.0.0.1). Conflito com stack I2–I5 atual (4200/8080/8081/5433).
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8080
BFF_HOST_PORT=8081
WEB_HOST_PORT=4200
AUTH_MOCK_HOST_PORT=18082

POSTGRES_DB=autua_local
POSTGRES_USER=autua
POSTGRES_PASSWORD=CHANGE_ME_LOCAL_ONLY
POSTGRES_IMAGE_TAG=17-alpine

# Caminho ABSOLUTO do dump escolhido (Fase B — autorização + escolha obrigatória)
# Candidatos em C:\dev\Projetos\serpro\dump-dbdes_10197_radar_aux-*.sql
AUTUA_PG_BACKUP_PATH=

# Flyway: true após restore validado; false se o dump já contém schema alinhado
SPRING_FLYWAY_ENABLED=true

CORS_URLS=http://localhost:4200,http://127.0.0.1:4200
AUTUA_BFF_CORS_ALLOWED_ORIGINS=http://localhost:4200,http://127.0.0.1:4200
AUTUA_BFF_PUBLIC_BASE_URL=http://127.0.0.1:8081/autua-bff

# --- Auth mock (profile --profile auth-mock). Vazio = não força issuer local ---
GELUS_ISSUER_URI=
JWT_ISSUER_URI=
JWT_JWK_SET_URI=
AUTUA_BFF_AUTH_LOGIN_BASE_URL=
AUTUA_BFF_AUTENTICACAO_API_BASE_URL=
GELUS_CLIENT_ID=
GELUS_CLIENT_SECRET=
GELUS_AUDIENCE=10197_radar
LOCAL_ISSUER=http://auth-mock:8080/realms/autua-local
LOCAL_PUBLIC_BASE=http://127.0.0.1:18082
LOCAL_CLIENT_ID=autua-local
LOCAL_CLIENT_SECRET=autua-local-secret

# Homologação
AUTUA_ALLOW_DIRTY=0
